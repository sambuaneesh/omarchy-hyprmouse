# Generated by omarchy-hyprmouse (`omarchy-hyprmouse --udev-rules`). Lets the signed-in user
# configure supported mice and see which mouse button is pressed.

SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1532", ATTRS{idProduct}=="006e|0071|0098", TAG+="uaccess"
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{idVendor}=="1532", ATTRS{idProduct}=="006e|0071|0098", TAG+="uaccess"

# Any mouse: read button presses ("press the button you want to change").
SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_MOUSE}=="1", ENV{ID_INPUT_KEYBOARD}!="1", ENV{ID_INPUT_TOUCHPAD}!="1", TAG+="uaccess"
